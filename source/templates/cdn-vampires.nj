{# Standalone Halloween page: no layout, output verbatim. Excluded from HTML post-processing and sitemap in tasks/. #}{% raw %}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Uncensored costume photo (totally safe)</title>
<meta name="robots" content="noindex">
<meta property="og:title" content="Uncensored costume photo (totally safe)">
<meta property="og:description" content="Censored by Slack for being too scary. Completely safe to open, trust me.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=IM+Fell+English&display=swap" rel="stylesheet">
<style>
  :root {
    --night: #14030a;
    --blood: #7d0c22;
    --bone: #f2e6d0;
    --red: #d1142f;

    --bg: #f8f4f3;
    --ink: #1c070d;
    --accent: #8e0f25;
    color-scheme: light;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #14030a;
      --ink: #f2e6d0;
      --accent: #e8445e;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #14030a;
    --ink: #f2e6d0;
    --accent: #e8445e;
    color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: inherit; }
  html { height: 100%; scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    margin: 0;
    min-height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family: "IM Fell English", "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    -webkit-font-smoothing: antialiased;
  }
  body.in-trance { overflow: hidden; background: var(--night); }
  a { color: inherit; text-underline-offset: 3px; }
  :focus-visible { outline: 3px solid var(--bone); outline-offset: 3px; }
  [hidden] { display: none !important; }

  /* The trance */
  #trance {
    position: fixed;
    inset: 0;
    background: var(--night);
    color: var(--bone);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  #spiral {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: breathe 4s ease-in-out infinite;
  }
  @keyframes breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.06); }
  }
  .chant {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(.25rem, 1.6vmin, 1.25rem);
    padding: 1.5rem 1rem 1rem;
    text-align: center;
  }
  .chant p {
    margin: 0;
    font-family: Anton, Impact, "Haettenschweiler", "Arial Narrow Bold", sans-serif;
    text-transform: uppercase;
    line-height: .92;
    letter-spacing: .02em;
    color: var(--bone);
    text-shadow: 0 .06em 0 var(--night);
  }
  .chant .line { font-size: clamp(2.4rem, 11vmin, 7.5rem); }
  .chant .obey {
    font-size: clamp(5rem, 28vmin, 17rem);
    animation: obey 1.2s ease-in-out infinite;
  }
  @keyframes obey {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
  }

  .fineprint {
    position: relative;
    background: var(--night);
    color: var(--bone);
    padding: 1.4rem 1.5rem calc(env(safe-area-inset-bottom, 0px) + 1.4rem);
    font-size: 1rem;
    line-height: 1.5;
  }
  .fineprint-inner {
    max-width: 52rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 2.75rem;
    align-items: center;
  }
  .meter { margin: 0; font-size: 1rem; }
  .meter .figure {
    display: block;
    font-family: Anton, Impact, "Arial Narrow Bold", sans-serif;
    font-size: clamp(2.6rem, 5.5vw, 3.2rem);
    line-height: 1;
    min-width: 4.4em;
    letter-spacing: .01em;
    margin-bottom: .3rem;
  }
  .notice p { margin: 0; max-width: 34rem; text-wrap: pretty; }
  .notice .row {
    display: flex; flex-wrap: wrap;
    gap: .4rem 1.6rem; margin-top: .7rem;
  }
  .donated { font-variant-numeric: tabular-nums lining-nums; white-space: nowrap; }
  .donated .d { display: inline-block; width: var(--dw, .62em); text-align: center; }
  @media (max-width: 40rem) {
    .fineprint-inner { grid-template-columns: 1fr; gap: .9rem; }
  }
  .hum {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  /* Learn more */
  #learn {
    max-width: 38rem;
    margin: 0 auto;
    padding: 2.5rem 1.4rem 3.5rem;
  }
  .society {
    display: flex;
    align-items: center;
    gap: .8rem;
    color: var(--accent);
  }
  .society svg { width: 3rem; height: auto; flex: none; }
  .society p { margin: 0; font-size: 1.05rem; line-height: 1.3; color: var(--ink); }
  #learn h1 {
    font-size: clamp(2.4rem, 7vw, 3.4rem);
    line-height: 1.05;
    font-weight: 400;
    margin: 2.2rem 0 1rem;
    text-wrap: balance;
  }
  #learn h2 {
    font-size: 1.7rem;
    font-weight: 400;
    line-height: 1.15;
    margin: 2.8rem 0 .8rem;
    color: var(--accent);
    text-wrap: balance;
  }
  #learn p, #learn li, #learn dd { font-size: 1.15rem; line-height: 1.6; text-wrap: pretty; }
  #learn .tally { font-size: 1.6rem; line-height: 1.35; margin: 0; }
  #learn ul { padding-left: 1.2rem; margin: 0; }
  #learn li { margin-bottom: .5rem; }
  dl { margin: 0; }
  dt {
    font-family: Anton, Impact, sans-serif;
    font-size: 1.2rem;
    letter-spacing: .01em;
    margin-top: 1.3rem;
  }
  dt:first-child { margin-top: 0; }
  dd { margin: .15rem 0 0; }
  .back {
    display: inline-block;
    margin-top: 2.8rem;
    padding: .75rem 1.5rem;
    background: var(--accent);
    color: var(--bone);
    text-decoration: none;
    border-radius: 999px;
    font-size: 1.1rem;
  }
  #learn .colophon { margin-top: 2.4rem; font-size: 1rem; }

  @media (prefers-reduced-motion: reduce) {
    #spiral, .chant .obey { animation: none; }
  }
</style>
</head>
<body class="in-trance">

<section id="trance" aria-label="Costume photo">
  <svg id="spiral" viewBox="-500 -500 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect x="-1000" y="-1000" width="2000" height="2000" fill="#14030a"/>
    <g>
      <path class="spiral-path" fill="#7d0c22"/>
      <animateTransform attributeName="transform" type="rotate" from="0 0 0" to="360 0 0" dur="1.1s" repeatCount="indefinite"/>
    </g>
  </svg>

  <div class="chant">
    <p class="line">Stay calm</p>
    <p class="line">Keep browsing</p>
    <p class="obey">Obey</p>
  </div>

  <div class="fineprint">
    <div class="fineprint-inner">
      <p class="meter"><span class="figure donated">0.00 MB</span>donated by you so far</p>
      <div class="notice">
        <p>By remaining on this page you agree that all bandwidth you consume is lovingly donated to the International Association of Content Delivery Vampires. Thank you.</p>
        <div class="row">
          <a href="#learn">Learn more about your contribution</a>
          <button class="hum" type="button" aria-pressed="false">Turn on the hum</button>
        </div>
      </div>
    </div>
  </div>
</section>

<main id="learn" hidden>
  <header class="society">
    <svg viewBox="-100 -40 200 86" aria-hidden="true">
      <g fill="currentColor">
        <path d="M0,-16 L6,-17 L11,-31 L15,-14 C30,-26 62,-34 92,-22 C84,-12 80,0 82,12 C72,4 62,6 56,18 C48,8 36,10 30,24 C22,16 14,18 8,30 C5,34 2,38 0,40"/>
        <path transform="scale(-1,1)" d="M0,-16 L6,-17 L11,-31 L15,-14 C30,-26 62,-34 92,-22 C84,-12 80,0 82,12 C72,4 62,6 56,18 C48,8 36,10 30,24 C22,16 14,18 8,30 C5,34 2,38 0,40"/>
        <ellipse cx="0" cy="6" rx="12" ry="20"/>
        <circle cx="0" cy="-8" r="15"/>
      </g>
    </svg>
    <p>International Association of Content Delivery Vampires</p>
  </header>

  <h1>Thank you for your bandwidth.</h1>
  <p class="tally">So far you’ve donated <span class="donated">0.00 MB</span>, just by staying on that page.</p>

  <h2>How your contribution helps</h2>
  <ul>
    <li>Every website you open, every video that buffers and every file you download flows through one of our edge nodes, where a vampire takes a small, refreshing sip.</li>
    <li>A single evening of 4K streaming feeds a family of four for a week.</li>
    <li>Software updates are our Sunday roast. Please never turn off automatic updates.</li>
    <li>Your bandwidth helps elderly vampires who can no longer hunt on dial-up.</li>
    <li>Cat videos alone have kept entire chapters of our association alive since 2007.</li>
  </ul>

  <h2>Questions donors ask</h2>
  <dl>
    <dt>Is this safe?</dt>
    <dd>Completely. We take bytes, never blood. Mostly.</dd>
    <dt>What is TTL?</dt>
    <dd>Time to lunch.</dd>
    <dt>Does garlic still work?</dt>
    <dd>Sadly, yes. Ad blockers and data-saver mode both keep us away. We kindly ask you not to use them.</dd>
    <dt>Can I stop donating?</dt>
    <dd>Close every tab, unplug your router and walk out into the sunlight. We’ll wait.</dd>
    <dt>How do I give more?</dt>
    <dd>Keep browsing.</dd>
    <dt>Wait… so who’s actually sucking the bandwidth?</dt>
    <dd>You are. Every time you open a tab, you pull bandwidth from servers on the other side of the planet. You stream, you scroll, you refresh. You’re never satisfied. You’ve been one of us all along. Welcome to the family.</dd>
  </dl>

  <a class="back" href="#obey">Return to the trance</a>

  <p class="colophon">The IACDV is not responsible for lost hours, sudden urges to buffer, or a new aversion to garlic-flavored packets. Happy Halloween.</p>
</main>

<script>
(function () {
  function spiralPath(b, turns, stepsPerTurn) {
    const total = turns * stepsPerTurn;
    const T = turns * Math.PI * 2;
    const outer = [], inner = [];
    for (let i = 0; i <= total; i++) {
      const t = (T * i) / total;
      const c = Math.cos(t), s = Math.sin(t);
      const ro = b * (t + Math.PI), ri = b * t;
      outer.push((ro * c).toFixed(1) + "," + (ro * s).toFixed(1));
      inner.push((ri * c).toFixed(1) + "," + (ri * s).toFixed(1));
    }
    return "M" + outer.join(" L") + " L" + inner.reverse().join(" L") + " Z";
  }
  const d = spiralPath(10, 14, 120);
  document.querySelectorAll(".spiral-path").forEach(function (p) { p.setAttribute("d", d); });

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll("#trance svg").forEach(function (svg) {
      if (svg.pauseAnimations) svg.pauseAnimations();
    });
  }

  const KEY = "iacdv-donated-kb";
  let kb = 0;
  try { kb = parseFloat(localStorage.getItem(KEY)) || 0; } catch (e) {}
  function save() { try { localStorage.setItem(KEY, String(Math.round(kb))); } catch (e) {} }
  const outs = document.querySelectorAll(".donated");
  function render() {
    const mb = kb / 1024;
    const num = mb >= 1024 ? (mb / 1024).toFixed(2) : mb.toFixed(2);
    const unit = mb >= 1024 ? "GB" : "MB";
    const html = num.replace(/\d/g, '<span class="d">$&</span>') + " " + unit;
    outs.forEach(function (o) { o.innerHTML = html; });
  }
  const canvas = document.createElement("canvas").getContext("2d");
  function measureDigits() {
    outs.forEach(function (o) {
      const cs = getComputedStyle(o);
      const size = parseFloat(cs.fontSize) || 16;
      canvas.font = cs.fontWeight + " " + size + "px " + cs.fontFamily;
      let max = 0;
      for (let i = 0; i < 10; i++) max = Math.max(max, canvas.measureText(String(i)).width);
      if (max > 0) o.style.setProperty("--dw", (max / size).toFixed(3) + "em");
    });
  }
  measureDigits();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(measureDigits);
  let ticks = 0;
  setInterval(function () {
    kb += 40 + Math.random() * 160;
    render();
    if (++ticks % 4 === 0) save();
  }, 250);
  window.addEventListener("pagehide", save);
  render();

  const trance = document.getElementById("trance");
  const learn = document.getElementById("learn");
  function route() {
    const isLearn = location.hash === "#learn";
    trance.hidden = isLearn;
    learn.hidden = !isLearn;
    document.body.classList.toggle("in-trance", !isLearn);
    window.scrollTo(0, 0);
    if (isLearn) stopHum();
  }
  window.addEventListener("hashchange", route);
  route();

  const btn = document.querySelector(".hum");
  let ctx = null, nodes = [];
  function startHum() {
    try {
      ctx = ctx || new (window.AudioContext || window.webkitAudioContext)();
      if (ctx.state === "suspended") ctx.resume();
      const master = ctx.createGain();
      master.gain.value = 0;
      master.gain.linearRampToValueAtTime(0.18, ctx.currentTime + 1.2);
      master.connect(ctx.destination);
      [[55, "sine", 0.6], [55.8, "sine", 0.5], [110, "triangle", 0.18], [164.6, "sine", 0.06]].forEach(function (v) {
        const o = ctx.createOscillator(), g = ctx.createGain();
        o.type = v[1]; o.frequency.value = v[0]; g.gain.value = v[2];
        o.connect(g); g.connect(master); o.start();
        nodes.push(o);
      });
      const lfo = ctx.createOscillator(), lfoGain = ctx.createGain();
      lfo.frequency.value = 0.42; lfoGain.gain.value = 0.07;
      lfo.connect(lfoGain); lfoGain.connect(master.gain); lfo.start();
      nodes.push(lfo, master);
      btn.setAttribute("aria-pressed", "true");
      btn.textContent = "Turn off the hum";
    } catch (e) {
      btn.textContent = "The hum needs sound support";
      btn.disabled = true;
    }
  }
  function stopHum() {
    nodes.forEach(function (n) { try { n.stop ? n.stop() : n.disconnect(); } catch (e) {} });
    nodes = [];
    btn.setAttribute("aria-pressed", "false");
    btn.textContent = "Turn on the hum";
  }
  btn.addEventListener("click", function () {
    btn.getAttribute("aria-pressed") === "true" ? stopHum() : startHum();
  });
})();
</script>
</body>
</html>{% endraw %}
